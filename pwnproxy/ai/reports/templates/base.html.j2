<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 2rem auto; max-width: 860px; color: #1a1a1a; line-height: 1.55; }
  h1 { border-bottom: 2px solid #333; padding-bottom: .3rem; }
  h2 { border-bottom: 1px solid #ccc; padding-bottom: .25rem; margin-top: 2rem; }
  h3 { margin-top: 1.4rem; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  th, td { border: 1px solid #ccc; padding: .45rem .6rem; text-align: left; }
  th { background: #f3f3f3; }
  code, pre { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: .85em; background: #f6f6f6; }
  pre { padding: .7rem; overflow-x: auto; border-radius: 4px; }
  blockquote { border-left: 4px solid #d97706; margin: 0; padding: .4rem 1rem; background: #fffbeb; }
  details { border: 1px solid #ddd; border-radius: 4px; padding: .6rem 1rem; margin: 1rem 0; }
  summary { cursor: pointer; font-weight: 600; }
  @media print { details { display: block; } body { margin: 1cm; } }
</style>
</head>
<body>
{{ body }}
</body>
</html>
