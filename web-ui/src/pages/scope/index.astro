---
import Base from "@/layouts/Base.astro";
import Card from "@/ui/Card.astro";
---

<Base title="Scope" page="/scope">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-neutral-50">Scope</h1>
    <p class="mt-0.5 text-sm text-neutral-400">Define which targets are in scope for scanning</p>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <Card>
      <div slot="title">In Scope</div>
      <div class="mb-3 flex gap-2">
        <input id="in-scope-input" placeholder="*.example.com" class="flex-1 rounded-md border border-neutral-700 bg-neutral-800 px-2 py-1.5 text-xs text-neutral-100 placeholder-neutral-500" />
        <button id="add-in-scope-btn" class="rounded-md bg-primary-600 px-2 py-1.5 text-xs font-medium text-white hover:bg-primary-500">Add</button>
      </div>
      <div id="include-list">
        <div class="py-8 text-center text-sm text-neutral-600">No targets configured</div>
      </div>
    </Card>

    <Card>
      <div slot="title">Excluded</div>
      <div class="mb-3 flex gap-2">
        <input id="exclude-input" placeholder="*.bad.com" class="flex-1 rounded-md border border-neutral-700 bg-neutral-800 px-2 py-1.5 text-xs text-neutral-100 placeholder-neutral-500" />
        <button id="add-exclude-btn" class="rounded-md bg-primary-600 px-2 py-1.5 text-xs font-medium text-white hover:bg-primary-500">Add</button>
      </div>
      <div id="exclude-list">
        <div class="py-8 text-center text-sm text-neutral-600">No exclusions</div>
      </div>
    </Card>

    <Card variant="accent">
      <div slot="title">Import from Burp</div>
      <p class="mb-3 text-xs text-neutral-500">Upload a Burp Suite project config JSON to import scope rules.</p>
      <input
        id="burp-file"
        type="file"
        accept=".json"
        class="mb-3 block w-full text-xs text-neutral-400 file:mr-2 file:rounded file:border-0 file:bg-primary-800 file:px-2 file:py-1 file:text-xs file:font-medium file:text-primary-200 hover:file:bg-primary-700"
      />
      <button
        id="import-btn"
        class="inline-flex items-center gap-2 rounded-md bg-primary-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-500 disabled:cursor-not-allowed disabled:bg-primary-800 disabled:text-primary-400"
        disabled
      >
        Import
      </button>
      <div id="import-result" class="mt-3 hidden"></div>
    </Card>
  </div>

  <div class="mt-6">
    <Card>
      <div slot="title">Scope Summary</div>
      <div class="flex items-center gap-6">
        <div>
          <span class="text-xs text-neutral-500">Include rules</span>
          <p id="summary-include" class="text-lg font-bold text-neutral-50">0</p>
        </div>
        <div>
          <span class="text-xs text-neutral-500">Exclude rules</span>
          <p id="summary-exclude" class="text-lg font-bold text-neutral-50">0</p>
        </div>
        <div>
          <span class="text-xs text-neutral-500">Scope file</span>
          <p id="summary-file" class="text-sm font-mono text-neutral-400">~/.pwnproxy/sessions/default/scope.json</p>
        </div>
        <div>
          <label class="flex items-center gap-2 text-xs text-neutral-400">
            <input type="checkbox" id="scope-enabled" class="accent-primary-500" />
            Enabled
          </label>
        </div>
      </div>
    </Card>
  </div>
</Base>

<script>
  import { importBurpConfig } from "@/api/scan/calls";
  import { getScope, updateScope } from "@/api/scope/calls";
  import type { ScopeConfig } from "@/api/scope/calls";

  let scope: ScopeConfig = { in_scope: [], out_of_scope: [], include_subdomains: true, ports: [80, 443], enabled: false };

  const includeList = document.getElementById("include-list") as HTMLDivElement;
  const excludeList = document.getElementById("exclude-list") as HTMLDivElement;
  const summaryInclude = document.getElementById("summary-include") as HTMLParagraphElement;
  const summaryExclude = document.getElementById("summary-exclude") as HTMLParagraphElement;
  const scopeEnabled = document.getElementById("scope-enabled") as HTMLInputElement;
  const inScopeInput = document.getElementById("in-scope-input") as HTMLInputElement;
  const excludeInput = document.getElementById("exclude-input") as HTMLInputElement;
  const fileInput = document.getElementById("burp-file") as HTMLInputElement;
  const importBtn = document.getElementById("import-btn") as HTMLButtonElement;
  const importResult = document.getElementById("import-result") as HTMLDivElement;

  async function loadScope() {
    try {
      scope = await getScope();
      renderAll();
    } catch { /* silent */ }
  }

  async function saveScope() {
    try {
      await updateScope(scope);
    } catch { /* silent */ }
  }

  function renderAll() {
    renderList(includeList, scope.in_scope, "in");
    renderList(excludeList, scope.out_of_scope, "out");
    summaryInclude.textContent = String(scope.in_scope.length);
    summaryExclude.textContent = String(scope.out_of_scope.length);
    scopeEnabled.checked = scope.enabled;
  }

  function renderList(container: HTMLDivElement, items: string[], kind: "in" | "out") {
    if (items.length === 0) {
      container.innerHTML = `<div class="py-8 text-center text-sm text-neutral-600">No ${kind === "in" ? "targets" : "exclusions"} configured</div>`;
      return;
    }
    container.innerHTML = items.map((item, i) =>
      `<div class="flex items-center justify-between rounded bg-neutral-950 px-2 py-1.5 mb-1">
        <span class="flex items-center gap-2 text-xs font-mono text-neutral-300">
          <span class="${kind === "in" ? "text-success-500" : "text-danger-500"}">●</span>
          ${escapeHtml(item)}
        </span>
        <button data-kind="${kind}" data-index="${i}" class="delete-rule rounded px-1.5 py-0.5 text-xs text-neutral-500 hover:text-danger-500 hover:bg-neutral-800">✕</button>
      </div>`
    ).join("");

    container.querySelectorAll(".delete-rule").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const kind = (btn as HTMLElement).dataset.kind as "in" | "out";
        const idx = parseInt((btn as HTMLElement).dataset.index ?? "0", 10);
        if (kind === "in") scope.in_scope.splice(idx, 1);
        else scope.out_of_scope.splice(idx, 1);
        await saveScope();
        await loadScope();
        window.dispatchEvent(new CustomEvent("pwnproxy-toast", {
          detail: { title: "Rule deleted", message: "Scope rule removed", severity: "info" },
        }));
      });
    });
  }

  document.getElementById("add-in-scope-btn")?.addEventListener("click", async () => {
    const val = inScopeInput.value.trim();
    if (!val) return;
    scope.in_scope.push(val);
    inScopeInput.value = "";
    await saveScope();
    await loadScope();
  });

  inScopeInput.addEventListener("keydown", async (e) => {
    if (e.key === "Enter") (document.getElementById("add-in-scope-btn") as HTMLButtonElement)?.click();
  });

  document.getElementById("add-exclude-btn")?.addEventListener("click", async () => {
    const val = excludeInput.value.trim();
    if (!val) return;
    scope.out_of_scope.push(val);
    excludeInput.value = "";
    await saveScope();
    await loadScope();
  });

  excludeInput.addEventListener("keydown", async (e) => {
    if (e.key === "Enter") (document.getElementById("add-exclude-btn") as HTMLButtonElement)?.click();
  });

  scopeEnabled.addEventListener("change", async () => {
    scope.enabled = scopeEnabled.checked;
    await saveScope();
    window.dispatchEvent(new CustomEvent("pwnproxy-toast", {
      detail: { title: scope.enabled ? "Scope enabled" : "Scope disabled", message: `Scope filtering is now ${scope.enabled ? "ON" : "OFF"}`, severity: "info" },
    }));
  });

  // Burp import
  fileInput.addEventListener("change", () => {
    importBtn.disabled = !fileInput.files || fileInput.files.length === 0;
  });

  importBtn.addEventListener("click", async () => {
    const file = fileInput.files?.[0];
    if (!file) return;

    importBtn.disabled = true;
    importBtn.textContent = "Importing...";
    importResult.classList.add("hidden");

    try {
      const text = await file.text();
      const data = await importBurpConfig(text);

      importResult.classList.remove("hidden");
      if (data.imported > 0) {
        importResult.className = "mt-3 rounded-md border border-green-800 bg-green-900/20 p-3 text-xs text-green-400";
      } else {
        importResult.className = "mt-3 rounded-md border border-yellow-800 bg-yellow-900/20 p-3 text-xs text-yellow-400";
      }
      importResult.textContent = `Imported ${data.imported} rules (${data.include_count} include, ${data.exclude_count} exclude)`;

      window.dispatchEvent(new CustomEvent("pwnproxy-toast", {
        detail: { title: data.imported > 0 ? "Burp config imported" : "No rules found", message: `${data.imported} rules loaded`, severity: data.imported > 0 ? "success" : "warning" },
      }));

      await loadScope();
    } catch (err: any) {
      importResult.classList.remove("hidden");
      importResult.className = "mt-3 rounded-md border border-red-800 bg-red-900/20 p-3 text-xs text-danger-500";
      importResult.textContent = err.message ?? "Import failed";
    } finally {
      importBtn.disabled = false;
      importBtn.textContent = "Import";
    }
  });

  function escapeHtml(s: string): string {
    const d = document.createElement("div");
    d.textContent = s;
    return d.innerHTML;
  }

  loadScope();
</script>
