---
import Base from "@/layouts/Base.astro";
import { RepeaterPage } from "@/components/repeater/RepeaterPage";
---

<Base title="Repeater" page="/repeater">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-neutral-50">Repeater</h1>
    <p class="mt-0.5 text-sm text-neutral-400">Send and replay HTTP requests — multiple tabs like Burp</p>
  </div>

  <div class="h-[calc(100vh-12rem)]">
    <RepeaterPage client:only="preact" />
  </div>
</Base>
