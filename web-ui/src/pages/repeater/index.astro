---
import Base from "@/layouts/Base.astro";
import Card from "@/ui/Card.astro";
---

<Base title="Repeater" page="/repeater">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-neutral-50">Repeater</h1>
    <p class="mt-0.5 text-sm text-neutral-400">Send and replay HTTP requests</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <Card>
        <div slot="title">Request</div>
        <form id="repeater-form">
          <textarea
            id="raw-request"
            rows="16"
            class="w-full rounded-md border border-neutral-700 bg-neutral-800 px-3 py-2 font-mono text-xs text-neutral-100 placeholder-neutral-500 transition-colors focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
            placeholder="GET / HTTP/1.1&#10;Host: example.com&#10;&#10;"
          >GET /get HTTP/1.1
Host: httpbin.org
User-Agent: pwnproxy-repeater/0.1
Accept: */*

</textarea>
          <div class="mt-3 flex items-center gap-3">
            <button
              type="submit"
              id="send-btn"
              class="inline-flex items-center gap-2 rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-500 disabled:cursor-not-allowed disabled:bg-primary-800 disabled:text-primary-400"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Send
            </button>
            <span id="timing" class="text-xs text-neutral-500"></span>
          </div>
        </form>
      </Card>
    </div>

    <div>
      <Card>
        <div slot="title">
          <div class="flex items-center justify-between">
            <span>Response</span>
            <label class="flex items-center gap-1.5 text-xs text-neutral-500 cursor-pointer select-none">
              <input type="checkbox" id="render-html" class="accent-primary-500" />
              Render HTML
            </label>
          </div>
        </div>
        <div id="response-area" class="space-y-3">
          <div class="flex items-center justify-center py-16 text-sm text-neutral-600">
            Send a request to see the response
          </div>
        </div>
      </Card>
    </div>
  </div>
</Base>

<script>
  import { sendRequest } from "@/api/repeater/calls";

  const form = document.getElementById("repeater-form") as HTMLFormElement;
  const rawInput = document.getElementById("raw-request") as HTMLTextAreaElement;
  const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;
  const timing = document.getElementById("timing") as HTMLSpanElement;
  const responseArea = document.getElementById("response-area") as HTMLDivElement;
  const renderToggle = document.getElementById("render-html") as HTMLInputElement;

  let lastBody = "";
  let lastContentType = "";

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const raw = rawInput.value;
    if (!raw.trim()) return;

    sendBtn.disabled = true;
    sendBtn.textContent = "Sending...";

    responseArea.innerHTML = `
      <div class="flex items-center justify-center py-12">
        <svg class="h-6 w-6 animate-spin text-primary-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
        <span class="ml-2 text-sm text-neutral-400">Sending...</span>
      </div>`;

    try {
      const data = await sendRequest({ raw_request: raw });

      const statusClass = data.status_code >= 400 ? "text-danger-500" : data.status_code >= 200 && data.status_code < 300 ? "text-success-500" : "text-neutral-400";

      const headersHtml = Object.entries(data.headers).map(([k, v]) =>
        `<div class="flex gap-2 text-xs"><span class="font-semibold text-neutral-400">${k}:</span><span class="text-neutral-300">${v}</span></div>`
      ).join("");

      lastBody = data.body_preview;
      lastContentType = data.headers?.["content-type"] ?? "";

      const isHtml = lastContentType.includes("text/html");

      responseArea.innerHTML = `
        <div class="flex items-center gap-3 rounded-md bg-neutral-950 px-3 py-2">
          <span class="text-lg font-bold ${statusClass}">${data.status_code}</span>
          <span class="text-xs text-neutral-500">${data.timing_ms}ms</span>
        </div>
        <details open class="rounded-md border border-neutral-800 bg-neutral-950">
          <summary class="cursor-pointer px-3 py-2 text-xs font-semibold uppercase tracking-wider text-neutral-400">Headers</summary>
          <div class="space-y-0.5 px-3 pb-2 pt-1">${headersHtml}</div>
        </details>
        <details open class="rounded-md border border-neutral-800 bg-neutral-950">
          <summary class="cursor-pointer px-3 py-2 text-xs font-semibold uppercase tracking-wider text-neutral-400">Body</summary>
          <div id="body-container" class="px-3 pb-2 pt-1"></div>
        </details>`;

      renderBody();
      renderToggle.style.display = isHtml ? "inline-flex" : "none";

      timing.textContent = `${data.timing_ms}ms`;

      window.dispatchEvent(new CustomEvent("pwnproxy-toast", {
        detail: { title: "Request sent", message: `${data.status_code} in ${data.timing_ms}ms`, severity: data.status_code >= 400 ? "error" : "success" },
      }));
    } catch (err: any) {
      responseArea.innerHTML = `
        <div class="rounded-md border border-red-800 bg-red-900/20 p-3">
          <p class="text-sm font-medium text-danger-500">Error</p>
          <p class="mt-1 text-xs text-neutral-400">${err.message ?? "Unknown"}</p>
        </div>`;
    } finally {
      sendBtn.disabled = false;
      sendBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polygon points="5 3 19 12 5 21 5 3"/></svg> Send`;
    }
  });

  function renderBody() {
    const container = document.getElementById("body-container");
    if (!container) return;

    if (renderToggle.checked && lastContentType.includes("text/html")) {
      container.innerHTML = `<iframe id="render-frame" class="w-full h-96 rounded border border-neutral-700 bg-white"></iframe>`;
      const frame = document.getElementById("render-frame") as HTMLIFrameElement;
      if (frame) {
        frame.srcdoc = lastBody;
      }
    } else {
      container.innerHTML = `<pre class="overflow-x-auto font-mono text-xs text-neutral-300">${escapeHtml(lastBody)}</pre>`;
    }
  }

  renderToggle.addEventListener("change", renderBody);

  function escapeHtml(s: string): string {
    const d = document.createElement("div");
    d.textContent = s;
    return d.innerHTML;
  }
</script>
