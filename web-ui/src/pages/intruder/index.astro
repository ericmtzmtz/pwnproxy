---
import Base from "@/layouts/Base.astro";
import Card from "@/ui/Card.astro";
---

<Base title="Intruder" page="/intruder">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-neutral-50">Intruder</h1>
    <p class="mt-0.5 text-sm text-neutral-400">Parameter fuzzing and brute-force attacks</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <Card>
        <div slot="title">Configuration</div>
        <form id="intruder-form" class="space-y-3">
          <div>
            <label class="mb-1 block text-xs text-neutral-400">Raw request (use § markers for positions)</label>
            <textarea
              id="intruder-request"
              rows="10"
              class="w-full rounded-md border border-neutral-700 bg-neutral-800 px-3 py-2 font-mono text-xs text-neutral-100 placeholder-neutral-500 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
            >GET /§search§ HTTP/1.1
Host: httpbin.org

</textarea>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="mb-1 block text-xs text-neutral-400">Mode</label>
              <select id="intruder-mode" class="w-full rounded-md border border-neutral-700 bg-neutral-800 px-3 py-2 text-sm text-neutral-100">
                <option value="sniper">Sniper</option>
                <option value="cluster_bomb">Cluster Bomb</option>
              </select>
            </div>
            <div>
              <label class="mb-1 block text-xs text-neutral-400">Wordlist path</label>
              <input id="wordlist-path" value="/usr/share/wordlists/dirb/common.txt" class="w-full rounded-md border border-neutral-700 bg-neutral-800 px-3 py-2 text-sm text-neutral-100 placeholder-neutral-500" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="mb-1 block text-xs text-neutral-400">Concurrency</label>
              <input id="concurrency" type="number" value="10" min="1" class="w-full rounded-md border border-neutral-700 bg-neutral-800 px-3 py-2 text-sm text-neutral-100" />
            </div>
            <div>
              <label class="mb-1 block text-xs text-neutral-400">Max results</label>
              <input id="max-results" type="number" value="100" min="1" class="w-full rounded-md border border-neutral-700 bg-neutral-800 px-3 py-2 text-sm text-neutral-100" />
            </div>
          </div>
          <button
            type="submit"
            id="intruder-btn"
            class="inline-flex items-center gap-2 rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-500 disabled:cursor-not-allowed disabled:bg-primary-800 disabled:text-primary-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><line x1="22" x2="18" y1="12" y2="12"/><line x1="6" x2="2" y1="12" y2="12"/><line x1="12" x2="12" y1="6" y2="2"/><line x1="12" x2="12" y1="22" y2="18"/></svg>
            Start Attack
          </button>
        </form>
      </Card>
    </div>

    <div>
      <Card>
        <div slot="title">Results</div>
        <div id="intruder-results">
          <div class="flex flex-col items-center justify-center py-16 text-sm text-neutral-600">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 h-10 w-10"><circle cx="12" cy="12" r="10"/><line x1="22" x2="18" y1="12" y2="12"/><line x1="6" x2="2" y1="12" y2="12"/><line x1="12" x2="12" y1="6" y2="2"/><line x1="12" x2="12" y1="22" y2="18"/></svg>
            <p>No attack started</p>
          </div>
        </div>
      </Card>
    </div>
  </div>
</Base>

<script>
  import { runIntruder } from "@/api/intruder/calls";
  import { pollTask } from "@/api/task/calls";

  const form = document.getElementById("intruder-form") as HTMLFormElement;
  const btn = document.getElementById("intruder-btn") as HTMLButtonElement;
  const resultsDiv = document.getElementById("intruder-results") as HTMLDivElement;
  const rawInput = document.getElementById("intruder-request") as HTMLTextAreaElement;
  const modeSel = document.getElementById("intruder-mode") as HTMLSelectElement;
  const wordlistInput = document.getElementById("wordlist-path") as HTMLInputElement;
  const concurrencyInput = document.getElementById("concurrency") as HTMLInputElement;

  function escapeHtml(s: string): string {
    const d = document.createElement("div");
    d.textContent = s;
    return d.innerHTML;
  }

  function renderResults(task: any) {
    const results = task.result?.results ?? [];
    const total = task.total;

    if (results.length === 0) {
      resultsDiv.innerHTML = `<div class="flex flex-col items-center justify-center py-12 text-sm text-neutral-600">No results</div>`;
      return;
    }

    resultsDiv.innerHTML = `
      <div class="mb-2 text-xs text-neutral-500">${total} total requests · ${results.length} results</div>
      <div class="overflow-x-auto rounded-md border border-neutral-800">
        <table class="w-full text-xs">
          <thead>
            <tr class="border-b border-neutral-800 bg-neutral-900">
              <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">#</th>
              <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Payload</th>
              <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Status</th>
              <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Length</th>
              <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Time</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800">
            ${results.map((r: any) => {
              const sc = r.status_code >= 400 ? "text-danger-500" : r.status_code >= 200 && r.status_code < 300 ? "text-success-500" : "text-neutral-500";
              return `<tr class="bg-neutral-950 hover:bg-neutral-900/50">
                <td class="px-2 py-1.5 text-neutral-500">${r.request_id}</td>
                <td class="max-w-[150px] truncate px-2 py-1.5 font-mono text-neutral-300">${escapeHtml(r.payload)}</td>
                <td class="px-2 py-1.5 font-semibold ${sc}">${r.status_code}</td>
                <td class="px-2 py-1.5 text-neutral-400">${r.response_length}</td>
                <td class="px-2 py-1.5 text-neutral-500">${r.timing_ms?.toFixed(0)}ms</td>
              </tr>`;
            }).join("")}
          </tbody>
        </table>
      </div>`;

    window.dispatchEvent(new CustomEvent("pwnproxy-toast", {
      detail: { title: "Attack complete", message: `${results.length} results from ${total} requests`, severity: results.length > 0 ? "warning" : "info" },
    }));
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    btn.disabled = true;
    btn.textContent = "Running...";

    resultsDiv.innerHTML = `
      <div class="flex items-center justify-center py-12">
        <svg class="h-6 w-6 animate-spin text-primary-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
        <span class="ml-2 text-sm text-neutral-400">Starting...</span>
      </div>`;

    try {
      const data = await runIntruder({
        raw_request: rawInput.value,
        mode: modeSel.value,
        wordlist_path: wordlistInput.value,
        concurrency: parseInt(concurrencyInput.value) || 10,
      });

      const taskId = data.task_id;
      resultsDiv.innerHTML = `
        <div class="flex items-center justify-center py-12">
          <svg class="h-6 w-6 animate-spin text-primary-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
          <span class="ml-2 text-sm text-neutral-400">Fuzzing...</span>
        </div>`;

      let done = false;
      while (!done) {
        await new Promise((r) => setTimeout(r, 1000));
        const task = await pollTask(taskId);
        if (task.status === "completed" || task.status === "failed") {
          done = true;
          if (task.status === "failed") {
            resultsDiv.innerHTML = `
              <div class="rounded-md border border-red-800 bg-red-900/20 p-3">
                <p class="text-sm font-medium text-danger-500">Attack failed</p>
                <p class="mt-1 text-xs text-neutral-400">${task.error ?? "Unknown error"}</p>
              </div>`;
            window.dispatchEvent(new CustomEvent("pwnproxy-toast", {
              detail: { title: "Attack failed", message: task.error ?? "Unknown error", severity: "error" },
            }));
          } else {
            renderResults(task);
          }
        }
      }
    } catch (err: any) {
      resultsDiv.innerHTML = `
        <div class="rounded-md border border-red-800 bg-red-900/20 p-3">
          <p class="text-sm font-medium text-danger-500">Error</p>
          <p class="mt-1 text-xs text-neutral-400">${err.message ?? "Unknown"}</p>
        </div>`;
    } finally {
      btn.disabled = false;
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><line x1="22" x2="18" y1="12" y2="12"/><line x1="6" x2="2" y1="12" y2="12"/><line x1="12" x2="12" y1="6" y2="2"/><line x1="12" x2="12" y1="22" y2="18"/></svg> Start Attack`;
    }
  });
</script>
