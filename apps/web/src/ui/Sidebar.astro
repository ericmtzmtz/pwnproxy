---
export interface Props {
  current: string;
  open: boolean;
}

const { current, open } = Astro.props;

interface NavItem {
  href: string;
  label: string;
  icon: string;
}

const nav: NavItem[] = [
  { href: "/", label: "Dashboard", icon: "grid" },
  { href: "/proxy", label: "Proxy", icon: "zap" },
  { href: "/interceptor", label: "Interceptor", icon: "shield" },
  { href: "/scanners", label: "Scanners", icon: "search" },
  { href: "/repeater", label: "Repeater", icon: "repeat" },
  { href: "/intruder", label: "Intruder", icon: "crosshair" },
  { href: "/crawler", label: "Crawler", icon: "globe" },
  { href: "/bruteforce", label: "Bruteforce", icon: "hash" },
  { href: "/scope", label: "Scope", icon: "target" },
  { href: "/reports", label: "Reports", icon: "file-text" },
  { href: "/settings", label: "Settings", icon: "settings" },
];
---

<aside
  id="sidebar"
  data-open={open}
  class="flex w-56 flex-col border-r border-neutral-800 bg-neutral-900 transition-transform duration-200 max-lg:fixed max-lg:inset-y-0 max-lg:left-0 max-lg:z-40 max-lg:data-[open=false]:-translate-x-full lg:relative"
>
  <div class="flex items-center gap-2 border-b border-neutral-800 px-4 py-4">
    <span class="inline-flex h-5 w-5 items-center justify-center rounded-sm bg-primary-500 text-[10px] font-bold text-white">
      P
    </span>
    <span class="text-base font-bold tracking-tight text-neutral-50">pwnproxy</span>
    <span id="sidebar-session-name" class="ml-auto max-w-[100px] truncate rounded bg-primary-800/40 px-1.5 py-0.5 text-[10px] font-medium text-primary-200" title="Session">--</span>
  </div>
  <nav class="flex-1 space-y-0.5 overflow-y-auto px-2 py-3">
    {nav.map((item) => (
      <a
        href={item.href}
        class={`flex items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium transition-colors ${
          current === item.href
            ? "bg-primary-800/40 text-primary-200"
            : "text-neutral-400 hover:bg-neutral-800 hover:text-neutral-200"
        }`}
      >
        <span class="inline-flex h-4 w-4 items-center justify-center">
          {item.icon === "grid" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          )}
            {item.icon === "zap" && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            )}
            {item.icon === "shield" && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            )}
          {item.icon === "search" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          )}
          {item.icon === "repeat" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          )}
          {item.icon === "crosshair" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><line x1="22" x2="18" y1="12" y2="12"/><line x1="6" x2="2" y1="12" y2="12"/><line x1="12" x2="12" y1="6" y2="2"/><line x1="12" x2="12" y1="22" y2="18"/></svg>
          )}
          {item.icon === "globe" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          )}
          {item.icon === "hash" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
          )}
          {item.icon === "target" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          )}
          {item.icon === "file-text" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          )}
          {item.icon === "settings" && (
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          )}
        </span>
        {item.label}
        {item.href === "/scanners" && (
          <span id="sidebar-scanners-badge" class="ml-auto hidden inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-primary-600 px-1 text-[10px] font-bold text-white">0</span>
        )}
      </a>
    ))}
    <hr class="my-2 border-neutral-800" />
    <div>
      <button
        id="sidebar-sessions-toggle"
        class="flex w-full items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-neutral-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        Sessions
        <svg id="sidebar-sessions-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto h-3 w-3 transition-transform"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="sidebar-sessions-sub" class="hidden space-y-0.5 pl-7">
        <button id="sidebar-session-switch" class="w-full rounded px-3 py-1.5 text-left text-[13px] font-medium text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-neutral-200">Switch session...</button>
        <button id="sidebar-session-new" class="w-full rounded px-3 py-1.5 text-left text-[13px] font-medium text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-neutral-200">New session...</button>
      </div>
    </div>
  </nav>
</aside>

<!-- Switch session modal -->
<div id="modal-switch" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/60">
  <div class="w-80 rounded-lg border border-neutral-700 bg-neutral-900 p-4 shadow-xl">
    <h3 class="text-sm font-bold text-neutral-200">Switch Session</h3>
    <div id="modal-switch-list" class="mt-2 max-h-48 space-y-1 overflow-y-auto"></div>
    <div class="mt-3 flex items-center gap-2">
      <input id="modal-switch-input" type="text" placeholder="Or type session name…" class="flex-1 rounded-md border border-neutral-700 bg-neutral-800 px-2.5 py-1.5 text-xs text-neutral-200 outline-none placeholder:text-neutral-600 focus:border-primary-500">
      <button id="modal-switch-go" class="rounded-md bg-primary-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-primary-500">Switch</button>
    </div>
    <button id="modal-switch-close" class="mt-2 w-full rounded py-1 text-xs text-neutral-500 hover:text-neutral-300">Cancel</button>
  </div>
</div>

<!-- New session modal -->
<div id="modal-new" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/60">
  <div class="w-80 rounded-lg border border-neutral-700 bg-neutral-900 p-4 shadow-xl">
    <h3 class="text-sm font-bold text-neutral-200">New Session</h3>
    <div class="mt-3">
      <input id="modal-new-input" type="text" placeholder="Session name…" class="w-full rounded-md border border-neutral-700 bg-neutral-800 px-2.5 py-1.5 text-xs text-neutral-200 outline-none placeholder:text-neutral-600 focus:border-primary-500">
    </div>
    <div class="mt-3 flex items-center gap-2">
      <button id="modal-new-go" class="flex-1 rounded-md bg-primary-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-primary-500">Create</button>
      <button id="modal-new-close" class="flex-1 rounded-md border border-neutral-700 px-3 py-1.5 text-xs font-medium text-neutral-400 hover:text-neutral-200">Cancel</button>
    </div>
  </div>
</div>

<script>
  import { API_BASE } from "@/core";

  const nameEl = document.getElementById("sidebar-session-name");
  const toggleBtn = document.getElementById("sidebar-sessions-toggle");
  const sub = document.getElementById("sidebar-sessions-sub");
  const chevron = document.getElementById("sidebar-sessions-chevron");

  const switchModal = document.getElementById("modal-switch");
  const switchList = document.getElementById("modal-switch-list");
  const switchInput = document.getElementById("modal-switch-input");
  const switchGo = document.getElementById("modal-switch-go");
  const switchClose = document.getElementById("modal-switch-close");

  const newModal = document.getElementById("modal-new");
  const newInput = document.getElementById("modal-new-input");
  const newGo = document.getElementById("modal-new-go");
  const newClose = document.getElementById("modal-new-close");

  function openModal(el) { el.classList.remove("hidden"); }
  function closeModal(el) { el.classList.add("hidden"); }

  async function loadSession(name) {
    await fetch(`${API_BASE}/sessions/manage`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ action: "load", name }),
    });
    localStorage.setItem("session-active", name);
    window.location.reload();
  }

  async function createSession(name) {
    await fetch(`${API_BASE}/sessions/manage`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ action: "create", name: name.trim() }),
    });
    localStorage.setItem("session-active", name.trim());
    window.location.reload();
  }

  async function fetchSession() {
    try {
      const res = await fetch(`${API_BASE}/sessions/active`);
      if (res.ok) {
        const data = await res.json();
        nameEl.textContent = data.name || "(none)";
        nameEl.title = data.name ? `Session: ${data.name}` : "No session";
      }
    } catch {}
  }

  fetchSession();

  toggleBtn?.addEventListener("click", () => {
    sub?.classList.toggle("hidden");
    chevron?.classList.toggle("rotate-180");
  });

  /* ── Switch modal ── */
  document.getElementById("sidebar-session-switch")?.addEventListener("click", async () => {
    const [activeRes, sessions] = await Promise.all([
      fetch(`${API_BASE}/sessions/active`),
      (await fetch(`${API_BASE}/sessions`)).json(),
    ]);
    const activeData = activeRes.ok ? await activeRes.json() : null;
    const active = activeData?.name ?? null;
    switchList.innerHTML = "";
    for (const s of sessions) {
      const btn = document.createElement("button");
      btn.className = "w-full rounded px-2.5 py-1.5 text-left text-xs font-medium transition-colors " +
        (s.name === active
          ? "bg-primary-800/30 text-primary-300"
          : "text-neutral-400 hover:bg-neutral-800 hover:text-neutral-200");
      btn.textContent = s.name === active ? `${s.name}  (active)` : s.name;
      btn.addEventListener("click", () => { closeModal(switchModal); loadSession(s.name); });
      switchList.appendChild(btn);
    }
    switchInput.value = "";
    openModal(switchModal);
    setTimeout(() => switchInput.focus(), 100);
  });

  switchGo?.addEventListener("click", async () => {
    const v = switchInput.value.trim();
    if (v) { closeModal(switchModal); await loadSession(v); }
  });
  switchInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") switchGo?.click();
  });
  switchClose?.addEventListener("click", () => closeModal(switchModal));
  switchModal?.addEventListener("click", (e) => {
    if (e.target === switchModal) closeModal(switchModal);
  });

  /* ── New session modal ── */
  document.getElementById("sidebar-session-new")?.addEventListener("click", async () => {
    newInput.value = "";
    openModal(newModal);
    setTimeout(() => newInput.focus(), 100);
  });

  newGo?.addEventListener("click", async () => {
    const v = newInput.value.trim();
    if (v) { closeModal(newModal); await createSession(v); }
  });
  newInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") newGo?.click();
  });
  newClose?.addEventListener("click", () => closeModal(newModal));
  newModal?.addEventListener("click", (e) => {
    if (e.target === newModal) closeModal(newModal);
  });
</script>
