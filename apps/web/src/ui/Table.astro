---
export interface Props {
  headers: string[];
}
const { headers } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border border-neutral-800">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-neutral-800 bg-neutral-900">
        {headers.map((h) => (
          <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-neutral-400">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-800">
      <slot />
    </tbody>
  </table>
</div>
