---
import Base from "@/layouts/Base.astro";
import Card from "@/ui/Card.astro";
import { ReportGenerator } from "@/components/reports/ReportGenerator";
---

<Base title="Reports" page="/reports">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-neutral-50">Reports</h1>
    <p class="mt-0.5 text-sm text-neutral-400">AI-written reports from session findings, or export raw data</p>
  </div>

  <Card>
    <div slot="title">Generate report</div>
    <ReportGenerator client:load />
  </Card>

  <div class="mb-4 mt-6 flex flex-wrap items-center gap-2">
    <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Raw findings</span>
    <div id="scanner-filters" class="flex flex-wrap items-center gap-2" aria-busy="true">
      <button
        type="button"
        data-scanner="all"
        class="scanner-filter rounded-md bg-primary-600 px-3 py-1.5 text-xs font-medium text-white transition-colors"
      >All</button>
    </div>
  </div>

  <Card>
    <div slot="title">Findings</div>
    <div id="findings-content">
      <div class="flex items-center justify-center py-16 text-sm text-neutral-600">
        Select a scanner to view findings
      </div>
    </div>
  </Card>
</Base>

<script>
  import { listFindings } from "@/api/findings/calls";
  import { listPlugins } from "@/api/plugins/calls";
  import { el, svgIcon } from "@/utils/dom";

  const findingsDiv = document.getElementById("findings-content") as HTMLDivElement;
  const filtersDiv = document.getElementById("scanner-filters");

  const FILTER_ACTIVE = "scanner-filter rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-primary-600 text-white";
  const FILTER_IDLE = "scanner-filter rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-neutral-800 text-neutral-400 hover:bg-neutral-700";
  const SEVERITY_COLOR: Record<string, string> = { critical: "text-red-400", high: "text-orange-400", medium: "text-yellow-400", low: "text-blue-400", info: "text-neutral-400" };

  function note(text: string): HTMLSpanElement {
    return el("span", "text-[11px] text-neutral-500", text);
  }

  function spinner(): HTMLElement {
    const row = el("div", "flex items-center justify-center py-8");
    row.append(
      svgIcon(
        [
          ["circle", { class: "opacity-25", cx: "12", cy: "12", r: "10", stroke: "currentColor", "stroke-width": "4" }],
          ["path", { class: "opacity-75", fill: "currentColor", d: "M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" }],
        ],
        "h-5 w-5 animate-spin text-primary-400",
      ),
      el("span", "ml-2 text-xs text-neutral-500", "Loading..."),
    );
    return row;
  }

  function emptyState(message: string): HTMLElement {
    const wrap = el("div", "flex flex-col items-center justify-center py-16 text-sm text-neutral-600");
    wrap.append(
      svgIcon([["path", { d: "M20 6 9 17l-5-5" }]], "mb-3 h-10 w-10"),
      el("p", undefined, message),
    );
    return wrap;
  }

  function errorState(message: string): HTMLElement {
    const wrap = el("div", "rounded-md border border-red-800 bg-red-900/20 p-3");
    wrap.append(
      el("p", "text-sm font-medium text-danger-500", "Error loading findings"),
      el("p", "mt-1 text-xs text-neutral-400", message),
    );
    return wrap;
  }

  function headerCell(label: string): HTMLTableCellElement {
    return el("th", "px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400", label);
  }

  /** Scanner, severity, URL, param, technique and payload all come from the target. */
  function findingRow(finding: { scanner: string; severity: string; url: string; param_name: string; technique: string; payload: string }): HTMLTableRowElement {
    const row = el("tr", "bg-neutral-950 hover:bg-neutral-900/50");
    const url = el("td", "max-w-[250px] truncate px-2 py-1.5 text-neutral-400", finding.url);
    url.title = finding.url;
    const payload = el("td", "max-w-[150px] truncate px-2 py-1.5 font-mono text-neutral-400", finding.payload);
    payload.title = finding.payload;
    row.append(
      el("td", "px-2 py-1.5 font-mono uppercase text-neutral-300", finding.scanner),
      el("td", `px-2 py-1.5 font-semibold ${SEVERITY_COLOR[finding.severity] ?? "text-neutral-400"}`, finding.severity),
      url,
      el("td", "px-2 py-1.5 font-mono text-neutral-300", finding.param_name),
      el("td", "px-2 py-1.5 text-neutral-400", finding.technique),
      payload,
    );
    return row;
  }

  function findingsTable(items: { scanner: string; severity: string; url: string; param_name: string; technique: string; payload: string }[]): HTMLElement {
    const wrap = el("div", undefined);
    wrap.append(el("div", "mb-2 text-xs text-neutral-500", `${items.length} finding${items.length !== 1 ? "s" : ""}`));

    const table = el("table", "w-full text-xs");
    const headRow = el("tr", "border-b border-neutral-800 bg-neutral-900");
    headRow.append(
      headerCell("Scanner"),
      headerCell("Severity"),
      headerCell("URL"),
      headerCell("Param"),
      headerCell("Technique"),
      headerCell("Payload"),
    );
    const thead = el("thead", undefined);
    thead.append(headRow);

    const tbody = el("tbody", "divide-y divide-neutral-800");
    for (const item of items) tbody.append(findingRow(item));

    table.append(thead, tbody);
    const scroller = el("div", "overflow-x-auto rounded-md border border-neutral-800");
    scroller.append(table);
    wrap.append(scroller);
    return wrap;
  }

  /**
   * The filter list comes from the plugin catalog, never from a literal: a
   * scanner added as an installed package gets a filter here with no code change.
   * Disabled and broken plugins stay in the list on purpose — findings they
   * produced before are still in the database.
   */
  async function loadFilters(): Promise<void> {
    if (!filtersDiv) return;
    try {
      const data = await listPlugins();
      if (data.error !== null) {
        filtersDiv.append(note(`Plugin catalog unavailable: ${data.error}`));
        return;
      }
      for (const plugin of data.plugins) {
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.scanner = plugin.name;
        button.className = FILTER_IDLE;
        button.textContent = plugin.name.toUpperCase();
        if (plugin.error !== null && plugin.error.length > 0) {
          button.title = `Broken plugin: ${plugin.error}`;
        } else if (!plugin.enabled) {
          button.title = "Disabled plugin — findings it produced earlier are still listed";
        }
        filtersDiv.append(button);
      }
    } catch (err: unknown) {
      filtersDiv.append(note(`Could not list scanners: ${err instanceof Error ? err.message : String(err)}`));
    } finally {
      filtersDiv.setAttribute("aria-busy", "false");
    }
  }

  filtersDiv?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !filtersDiv.contains(target)) return;
    const scanner = target.dataset.scanner;
    if (!scanner) return;
    filtersDiv.querySelectorAll<HTMLButtonElement>("button.scanner-filter").forEach((b) => {
      b.className = FILTER_IDLE;
    });
    target.className = FILTER_ACTIVE;
    await loadFindings(scanner);
  });

  async function loadFindings(scanner: string) {
    findingsDiv.replaceChildren(spinner());

    try {
      const data = await listFindings(1, 100);
      let items = data.items ?? [];

      if (scanner !== "all") {
        items = items.filter((f) => f.scanner === scanner);
      }

      if (items.length === 0) {
        findingsDiv.replaceChildren(emptyState("No findings"));
        return;
      }

      findingsDiv.replaceChildren(findingsTable(items));
    } catch (err: unknown) {
      findingsDiv.replaceChildren(
        errorState(err instanceof Error ? err.message : String(err)),
      );
    }
  }

  loadFindings("all");
  void loadFilters();
</script>
