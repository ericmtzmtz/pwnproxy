---
import Base from "@/layouts/Base.astro";
import Card from "@/ui/Card.astro";
import { ReportGenerator } from "@/components/reports/ReportGenerator";
---

<Base title="Reports" page="/reports">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-neutral-50">Reports</h1>
    <p class="mt-0.5 text-sm text-neutral-400">AI-written reports from session findings, or export raw data</p>
  </div>

  <Card>
    <div slot="title">Generate report</div>
    <ReportGenerator client:load />
  </Card>

  <div class="mb-4 mt-6 flex flex-wrap items-center gap-2">
    <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Raw findings</span>
    <div id="scanner-filters" class="flex flex-wrap items-center gap-2" aria-busy="true">
      <button
        type="button"
        data-scanner="all"
        class="scanner-filter rounded-md bg-primary-600 px-3 py-1.5 text-xs font-medium text-white transition-colors"
      >All</button>
    </div>
  </div>

  <Card>
    <div slot="title">Findings</div>
    <div id="findings-content">
      <div class="flex items-center justify-center py-16 text-sm text-neutral-600">
        Select a scanner to view findings
      </div>
    </div>
  </Card>
</Base>

<script>
  import { listFindings } from "@/api/findings/calls";
  import { listPlugins } from "@/api/plugins/calls";

  function esc(v: unknown): string {
    return String(v ?? "-").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  const findingsDiv = document.getElementById("findings-content") as HTMLDivElement;
  const filtersDiv = document.getElementById("scanner-filters");

  const FILTER_ACTIVE = "scanner-filter rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-primary-600 text-white";
  const FILTER_IDLE = "scanner-filter rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-neutral-800 text-neutral-400 hover:bg-neutral-700";

  function note(text: string): HTMLSpanElement {
    const span = document.createElement("span");
    span.className = "text-[11px] text-neutral-500";
    span.textContent = text;
    return span;
  }

  /**
   * The filter list comes from the plugin catalog, never from a literal: a
   * scanner added as an installed package gets a filter here with no code change.
   * Disabled and broken plugins stay in the list on purpose — findings they
   * produced before are still in the database.
   */
  async function loadFilters(): Promise<void> {
    if (!filtersDiv) return;
    try {
      const data = await listPlugins();
      if (data.error !== null) {
        filtersDiv.append(note(`Plugin catalog unavailable: ${data.error}`));
        return;
      }
      for (const plugin of data.plugins) {
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.scanner = plugin.name;
        button.className = FILTER_IDLE;
        button.textContent = plugin.name.toUpperCase();
        if (plugin.error !== null && plugin.error.length > 0) {
          button.title = `Broken plugin: ${plugin.error}`;
        } else if (!plugin.enabled) {
          button.title = "Disabled plugin — findings it produced earlier are still listed";
        }
        filtersDiv.append(button);
      }
    } catch (err: unknown) {
      filtersDiv.append(note(`Could not list scanners: ${err instanceof Error ? err.message : String(err)}`));
    } finally {
      filtersDiv.setAttribute("aria-busy", "false");
    }
  }

  filtersDiv?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !filtersDiv.contains(target)) return;
    const scanner = target.dataset.scanner;
    if (!scanner) return;
    filtersDiv.querySelectorAll<HTMLButtonElement>("button.scanner-filter").forEach((b) => {
      b.className = FILTER_IDLE;
    });
    target.className = FILTER_ACTIVE;
    await loadFindings(scanner);
  });

  async function loadFindings(scanner: string) {
    findingsDiv.innerHTML = `
      <div class="flex items-center justify-center py-8">
        <svg class="h-5 w-5 animate-spin text-primary-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
        <span class="ml-2 text-xs text-neutral-500">Loading...</span>
      </div>`;

    try {
      const data = await listFindings(1, 100);
      let items = data.items ?? [];

      if (scanner !== "all") {
        items = items.filter((f) => f.scanner === scanner);
      }

      if (items.length === 0) {
        findingsDiv.innerHTML = `
          <div class="flex flex-col items-center justify-center py-16 text-sm text-neutral-600">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 h-10 w-10"><path d="M20 6 9 17l-5-5"/></svg>
            <p>No findings</p>
          </div>`;
        return;
      }

      findingsDiv.innerHTML = `
        <div class="mb-2 text-xs text-neutral-500">${items.length} finding${items.length !== 1 ? "s" : ""}</div>
        <div class="overflow-x-auto rounded-md border border-neutral-800">
          <table class="w-full text-xs">
            <thead>
              <tr class="border-b border-neutral-800 bg-neutral-900">
                <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Scanner</th>
                <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Severity</th>
                <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">URL</th>
                <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Param</th>
                <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Technique</th>
                <th class="px-2 py-1.5 text-left font-semibold uppercase tracking-wider text-neutral-400">Payload</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-800">
              ${items.map((f) => {
                const sevColor: Record<string, string> = { critical: "text-red-400", high: "text-orange-400", medium: "text-yellow-400", low: "text-blue-400", info: "text-neutral-400" };
                return `<tr class="bg-neutral-950 hover:bg-neutral-900/50">
                  <td class="px-2 py-1.5 font-mono uppercase text-neutral-300">${esc(f.scanner)}</td>
                  <td class="px-2 py-1.5 font-semibold ${sevColor[f.severity] ?? "text-neutral-400"}">${esc(f.severity)}</td>
                  <td class="max-w-[250px] truncate px-2 py-1.5 text-neutral-400" title="${esc(f.url)}">${esc(f.url)}</td>
                  <td class="px-2 py-1.5 font-mono text-neutral-300">${esc(f.param_name)}</td>
                  <td class="px-2 py-1.5 text-neutral-400">${esc(f.technique)}</td>
                  <td class="max-w-[150px] truncate px-2 py-1.5 font-mono text-neutral-400" title="${esc(f.payload)}">${esc(f.payload)}</td>
                </tr>`;
              }).join("")}
            </tbody>
          </table>
        </div>`;
    } catch (err: unknown) {
      findingsDiv.innerHTML = `
        <div class="rounded-md border border-red-800 bg-red-900/20 p-3">
          <p class="text-sm font-medium text-danger-500">Error loading findings</p>
          <p class="mt-1 text-xs text-neutral-400">${esc(err instanceof Error ? err.message : String(err))}</p>
        </div>`;
    }
  }

  loadFindings("all");
  void loadFilters();
</script>
