# API base URL for pwnproxy backend
# Override the default http://127.0.0.1:8000/api/v1
# Usage: $env:PUBLIC_API_BASE="http://127.0.0.1:8000/api/v1" npm run dev
# Or via the dev wrapper: npm run dev -- --backend 127.0.0.1:8000
#   (--backend accepts IP:PORT or a full http(s)://host:port URL)
PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
