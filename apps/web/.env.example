# API base URL for pwnproxy backend
# Override the default http://127.0.0.1:17171/api/v1
# Usage: $env:PUBLIC_API_BASE="http://127.0.0.1:17171/api/v1" npm run dev
# Or via the dev wrapper: npm run dev -- --backend 127.0.0.1:17171
#   (--backend accepts IP:PORT or a full http(s)://host:port URL)
PUBLIC_API_BASE=http://127.0.0.1:17171/api/v1

# The API token does NOT go here.
# Anything in this file (PUBLIC_*) is embedded in the static bundle at build time,
# so a token would ship to every browser. The UI takes the token at runtime: from
# the URL fragment printed by `pwnproxy api token` / `dev.ps1` / `dev.sh`
# (http://127.0.0.1:17172/#token=<token>), or from its "paste the token" screen,
# and keeps it in localStorage.
