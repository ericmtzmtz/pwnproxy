# pwnproxy backend — proxy + API control plane
# Build:  docker build -f Dockerfile.backend -t pwnproxy-backend .
# Run:    docker run -p 8080:8080 -p 8000:8000 pwnproxy-backend

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps for mitmproxy (SSL/TLS) and poetry
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libssl-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install poetry
RUN pip install --no-cache-dir "poetry==1.8.5"

# Copy dependency manifests first (layer cache)
COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.create false \
    && poetry install --only main --no-interaction --no-ansi

# Copy source
COPY apps/ apps/
COPY pwnproxy/ pwnproxy/

# Data dir (sessions, db). HOME is set to /data at runtime so
# Path.home()/.pwnproxy resolves to a mounted volume.
RUN mkdir -p /data && chmod 777 /data

# pwnproxy CLI entry point
COPY deploy/docker/docker-entrypoint.sh /usr/local/bin/entrypoint
ENTRYPOINT ["sh", "/usr/local/bin/entrypoint"]
